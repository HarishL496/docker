name: Temperature Converter CI-CD Pipeline

on:
  push:
    branches:
      - main

jobs:
  devops-pipeline:
    runs-on: ubuntu-latest
    steps:
    # (1) & (2) Source Code & Version Control Stages
    - name: Checkout Code
      uses: actions/checkout@v4

    # (3) Continuous Integration Stage (Unit Testing)
    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    - name: Install Dependencies & Run Tests
      run: |
        pip install -r requirements.txt
        pytest

    # (4) Build Stage (Image creation & Registry Sync)
    - name: Log in to Docker Hub
      uses: docker/login-action@v3
      with:
        username: ${{ secrets.DOCKERHUB_USERNAME }}
        password: ${{ secrets.DOCKERHUB_PASSWORD }}

    - name: Build and Push Docker Image
      run: |
        IMAGE_TAG=${{ github.sha }}
        docker build -t ${{ secrets.DOCKERHUB_USERNAME }}/temp-converter:$IMAGE_TAG .
        docker push ${{ secrets.DOCKERHUB_USERNAME }}/temp-converter:$IMAGE_TAG

    # (5) Deployment Stage (Kubernetes Cluster Upgrade)
    - name: Set Kubernetes Context
      uses: azure/k8s-set-context@v4
      with:
        method: kubeconfig
        kubeconfig: ${{ secrets.KUBECONFIG }}

    - name: Deploy to Kubernetes Cluster
      run: |
        IMAGE_TAG=${{ github.sha }}
        sed -i "s|DOCKERHUB_USERNAME/temp-converter:IMAGE_TAG|${{ secrets.DOCKERHUB_USERNAME }}/temp-converter:$IMAGE_TAG|g" k8s/deployment.yaml
        kubectl apply -f k8s/deployment.yaml
        kubectl apply -f k8s/service.yaml
